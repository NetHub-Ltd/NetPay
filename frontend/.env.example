# NetPay frontend (Next.js static export)
NEXT_PUBLIC_SITE_URL=https://pay.example.com

# Optional: API origin when frontend dev server is separate from FastAPI (no trailing slash).
# Leave empty when the API serves the static export on the same origin.
NEXT_PUBLIC_NETPAY_API_BASE_URL=

# OIDC for the SPA is loaded at runtime from GET /config.json on the API
# (OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_REDIRECT_URI, OIDC_SCOPES). Do not put client secrets here.
