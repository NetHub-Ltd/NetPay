# NetPay frontend (Next.js static export)
# Copy this file to .env.local for local frontend development.
#
# The current frontend does not yet consume runtime environment variables.
# Keep browser-exposed configuration prefixed with NEXT_PUBLIC_ when it is wired.
#
# API base URL for future browser-side API integration:
# NEXT_PUBLIC_NETPAY_API_BASE_URL=http://localhost:8000
#
# NetHub OIDC integration is not wired into this frontend yet. Do not use the
# old VITE_OIDC_* names; those belong to the retired Vite frontend.
# NEXT_PUBLIC_OIDC_ISSUER=https://auth.nethub.co.ke
# NEXT_PUBLIC_OIDC_CLIENT_ID=replace-with-your-zitadel-client-id
# NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# NEXT_PUBLIC_OIDC_SCOPES=openid profile email
