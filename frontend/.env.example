# Zitadel / NetHub IdP — public SPA client (PKCE, no client secret in the browser)
VITE_OIDC_ISSUER=https://auth.nethub.co.ke
VITE_OIDC_CLIENT_ID=your-zitadel-spa-client-id
# Must match a redirect URI registered on the Zitadel app
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPES=openid profile email offline_access
