# Public canonical origin used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://pay.example.com

# Private server-to-server API origin. Never expose this with NEXT_PUBLIC_.
NETPAY_BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Must match backend BFF_INTERNAL_SECRET; keep it server-only.
# High-entropy secret (minimum 32 characters); must match backend/.env.
BFF_INTERNAL_SECRET=

# Public OIDC client registered with Zitadel/NetHubKe; Authorization Code + PKCE S256.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback/
OIDC_SCOPES=openid profile email
# At least 32 random characters; encrypts short-lived PKCE transaction cookies.
OIDC_TRANSACTION_SECRET=
