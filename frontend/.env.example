# Public canonical origin used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://netpay.nethub.co.ke

# Auth.js (human login — aligned with NetHubKe frontend)
# AUTH_URL must be the exact public origin users open in the browser (no path).
AUTH_URL=https://netpay.nethub.co.ke
# Stable secret across deploys; rotating mid-login breaks PKCE cookies.
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Public OIDC client (Authorization Code + PKCE). No client secret.
AUTH_OIDC_ISSUER=https://auth.nethub.co.ke
AUTH_OIDC_CLIENT_ID=
# Optional override; default is {issuer}/.well-known/openid-configuration
# AUTH_OIDC_WELL_KNOWN=
# AUTH_OIDC_SCOPES=openid profile email
# AUTH_USE_SECURE_COOKIES=true
# AUTH_DEBUG=true

# Zitadel redirect URI for this public client (exact):
#   https://netpay.nethub.co.ke/api/auth/callback/oidc

# Private NetPay FastAPI origin (merchant/payments BFF). Never NEXT_PUBLIC_.
NETPAY_BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional: still used by legacy helpers if present; not required for Auth.js human login.
# BFF_INTERNAL_SECRET=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URI=
# OIDC_TRANSACTION_SECRET=
