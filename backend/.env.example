# Local development defaults only. Never commit production secrets.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL credentials are separate from the driver-specific URLs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netpay
DB_USER=netpay
# Set a local-only password before connecting.
DB_PASSWORD=
# Use require for Aiven/managed PostgreSQL when TLS is required.
DB_SSL_MODE=prefer

# Per-process pool limits. Total connections multiply by workers and instances.
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Redis is auxiliary; PostgreSQL remains the source of truth.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Daraja Core. Supply keys through a secret manager in deployed environments.
# Format: key-id=Fernet-key,key-id-previous=Fernet-key; use 32-byte URL-safe base64 Fernet keys.
MPESA_CREDENTIAL_ENCRYPTION_KEYS=
MPESA_CREDENTIAL_ACTIVE_KEY_ID=v1
# Public backend origin that exposes /callbacks/mpesa/* to Safaricom; set explicitly per environment.
# Do not point a test integration at a production callback host.
MPESA_PUBLIC_BASE_URL=
MPESA_HTTP_TIMEOUT_SECONDS=10
# Optional public Safaricom X.509 PEM certificates, required for API-initiator operations (B2C/B2B/status/balance/reversal).
MPESA_SANDBOX_CERTIFICATE_PEM=
MPESA_PRODUCTION_CERTIFICATE_PEM=
