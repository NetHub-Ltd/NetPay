APP_NAME=NetHub Payment Gateway
ENVIRONMENT=development

# Required for human API auth — NetHub forwards IdP Bearer tokens here
NETHUB_API_BASE_URL=https://api.nethub.co.ke
NETHUB_API_TIMEOUT_SECONDS=8

# Platform admin = NetHub users whose email matches (comma-separated optional)
ADMIN_EMAIL=admin@nethub.test
ADMIN_EMAILS=

INTERNAL_API_KEY=change-me-internal-worker-secret

DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

CORS_ORIGINS=*
LOG_LEVEL=INFO

EDGE_PUBLIC_BASE_URL=https://gateway.nethub.co.ke
EDGE_CALLBACK_PATH_PREFIX=/cb
