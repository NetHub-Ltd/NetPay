# Local development defaults only. Never commit production secrets.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Development-only signing key; production must set a unique random value (32+ bytes).
SECRET_KEY=local-dev-secret-key-change-this-32chars
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this separately from the database and preserve it across deployments.
CREDENTIAL_ENCRYPTION_KEY=
MACHINE_TOKEN_TTL_MINUTES=60
MACHINE_TOKEN_AUDIENCE=netpay
# Optional operator-only key for creating M2M clients; use a random value of 32+ bytes.
# The provisioning endpoint is disabled when this is unset.
M2M_PROVISIONING_KEY=

# PostgreSQL credentials are separate from the driver-specific URLs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netpay
DB_USER=netpay
# Set a local-only password before connecting.
DB_PASSWORD=
# Use require for Aiven/managed PostgreSQL when TLS is required.
DB_SSL_MODE=prefer

# Per-process pool limits. Total connections multiply by workers and instances.
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Redis is auxiliary; PostgreSQL remains the source of truth.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
