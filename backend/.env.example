APP_NAME=NetPay
ENVIRONMENT=development

# Use PostgreSQL for local integration work; SQLite is supported for unit tests only.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Set both values securely in production. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Public origin used to generate stable NetPay-hosted Daraja callback URLs.
PUBLIC_BASE_URL=https://pay.nethub.co.ke

# Redis is auxiliary only; payment durability must not depend on Redis.
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
