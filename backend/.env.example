# Local development defaults only. Never commit production secrets.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://netpay:netpay@localhost:5432/netpay
# Redis is auxiliary; PostgreSQL remains the source of truth.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
