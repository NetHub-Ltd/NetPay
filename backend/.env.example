APP_NAME=NetHub Payment Gateway
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

ADMIN_EMAIL=admin@nethub.test
ADMIN_PASSWORD=ChangeMeAdmin123!

INTERNAL_API_KEY=change-me-internal-worker-secret

# One credential set → async app + sync Alembic
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
# DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=*
LOG_LEVEL=INFO
